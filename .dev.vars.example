# Start with free local testing. Copy this file to .dev.vars.
TEST_MODE=true
ALLOW_UNAUTHENTICATED_TEST_API=true
LIVE_GENERATION_ENABLED=false
LYRICS_PROVIDER=mock
MUSIC_PROVIDER=sunoapi.org
PUBLIC_BASE_URL=http://localhost:8787

# Deployed test/live instances fail closed without this secret.
# Generate a long random value and store it only as a secret.
# ADMIN_API_TOKEN=replace_me

# Free/low-cost real-LLM test option without Suno spend:
# LYRICS_PROVIDER=groq
# GROQ_API_KEY=replace_me
# GROQ_MODEL=openai/gpt-oss-120b

# Production lyrics provider requested for Música Salvaje:
# LYRICS_PROVIDER=xai
# XAI_API_KEY=replace_me
# XAI_MODEL=grok-4.3

# Real music provider selection.
# MUSIC_PROVIDER=sunoapi.org is the current supported live provider and is paid.
# MUSIC_PROVIDER=ace-step-github is intentionally fail-closed until the free
# ACE-Step benchmark/integration gate passes. It never falls back to Suno.

# Paid Suno music generation. Leave live mode disabled while testing.
# TEST_MODE=false
# ALLOW_UNAUTHENTICATED_TEST_API=false
# LIVE_GENERATION_ENABLED=true
# MUSIC_PROVIDER=sunoapi.org
# PUBLIC_BASE_URL=https://your-worker.workers.dev
# SUNO_API_KEY=replace_me
# SUNO_CALLBACK_SECRET=generate_a_long_random_secret
# SUNO_BASE_URL=https://api.sunoapi.org/api/v1
# SUNO_MODEL=V5

# GitHub renderer. Leave unset while testing the agent only.
# GITHUB_TOKEN=replace_me
# GITHUB_REPO=Savage9323/Musica-Salvaje
# GITHUB_RENDER_WORKFLOW=ffmpeg.yml
# GITHUB_RENDER_REF=main

# YouTube OAuth. Leave unset until private-upload testing.
# YOUTUBE_CLIENT_ID=replace_me
# YOUTUBE_CLIENT_SECRET=replace_me
# YOUTUBE_REFRESH_TOKEN=replace_me
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true

# Guardrails.
# Paid live mode fails closed unless DAILY and MONTHLY generation limits are positive.
QUALITY_GATE=8
MAX_LYRIC_REVISIONS=2
MAX_DAILY_PAID_GENERATIONS=2
MAX_MONTHLY_PAID_GENERATIONS=0
MIN_SUNO_CREDITS=1
