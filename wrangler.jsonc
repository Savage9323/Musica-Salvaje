{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musica-salvaje-agent",
  "main": "src/gateway.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "MusicaSalvajeAgent", "class_name": "MusicaSalvajeAgent" },
      { "name": "BudgetGate", "class_name": "BudgetGate" }
    ]
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "musica-salvaje-media" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MusicaSalvajeAgent"] },
    { "tag": "v2", "new_classes": ["BudgetGate"] }
  ],
  "vars": {
    "TEST_MODE": "true",
    "LIVE_GENERATION_ENABLED": "false",
    "LYRICS_PROVIDER": "mock",
    "QUALITY_GATE": "8",
    "MAX_LYRIC_REVISIONS": "2",
    "MAX_DAILY_PAID_GENERATIONS": "2",
    "MAX_MONTHLY_PAID_GENERATIONS": "0",
    "MIN_SUNO_CREDITS": "1",
    "SUNO_BASE_URL": "https://api.sunoapi.org/api/v1",
    "SUNO_MODEL": "V5",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "XAI_MODEL": "grok-4.3",
    "GITHUB_REPO": "Savage9323/Musica-Salvaje",
    "GITHUB_RENDER_WORKFLOW": "ffmpeg.yml",
    "GITHUB_RENDER_REF": "main",
    "YOUTUBE_CONTAINS_SYNTHETIC_MEDIA": "true"
  }
}
